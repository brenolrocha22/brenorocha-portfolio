# Copie para .env.local e preencha. Nunca versione valores reais.

# Público: URL canônica (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Servidor: formulário de contato (Resend) — entrega 5
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Opcional: vazio = onboarding@resend.dev (sem domínio próprio, D11). replyTo = e-mail do visitante.
CONTACT_FROM_EMAIL=

# Servidor: GitHub API (fine-grained, somente leitura de repos públicos) — entrega 6
GITHUB_TOKEN=

# Opcional: Turnstile (anti-spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcional: rate limit distribuído (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
